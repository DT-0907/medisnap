  DefaultScriptInputs:
    - autoShowHide: true
      innerSize: !<Vec2> {x: 32.000000, y: 32.000000}
      border: !<float> 4.000000
      constantPadding: !<Vec2> {x: 0.000000, y: 0.000000}
