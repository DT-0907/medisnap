- !<TypeScriptAssetData/351254ce-9f95-40af-8f28-f5ad0a3742a0>
  SvgIcon: ""
  SetupScript:
    code: ""
  Description: ""
  VersionMajor: 0
  VersionMinor: 0
  VersionPatch: 0
  ComponentUid: 07048e7e-a5df-4f31-ac23-bf6838a2a18b
  ExportUid: 00000000-0000-0000-0000-000000000000
